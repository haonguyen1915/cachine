# Example environment configuration for cachine
RUN_REDIS_TESTS=True
RUN_PERF_TESTS=True
RUN_REDIS_CLUSTER_TESTS=True
# Cache backend: inmemory | redis
CACHE_BACKEND=inmemory
CACHE_NAMESPACE=myapp

# Redis settings (used if CACHE_BACKEND=redis)
REDIS_SINGLE_URL="redis://:oneforall@localhost:6379/0?ssl=false"
REDIS_CLUSTER_URL="redis://admin:oneforall@localhost:7001,localhost:7002,localhost:7003"
; REDIS_HOST=localhost
; REDIS_PORT=6379
; REDIS_DB=0
; REDIS_PASSWORD=oneforall
; REDIS_SSL=false

