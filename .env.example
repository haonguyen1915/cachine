# Example environment configuration for cachine

# Cache backend: inmemory | redis
CACHE_BACKEND=inmemory

# Redis settings (used if CACHE_BACKEND=redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=secret
REDIS_SSL=false

# Optional namespace prefix
CACHE_NAMESPACE=myapp

# Enable Redis integration tests (set to 1/true/yes)
RUN_REDIS_TESTS=0
